{
  "name": "power-skiving-tool",
  "version": "0.1.0",
  "description": "车齿刀参数化设计与 3D 可视化桌面应用",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite --mode electron",
    "build": "vue-tsc --noEmit && vite build",
    "build:electron": "vue-tsc --noEmit && vite build --mode electron",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "element-plus": "^2.9.0",
    "three": "^0.170.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "happy-dom": "^20.11.1",
    "jsdom": "^29.1.1",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.powerskiving.tool",
    "productName": "PowerSkivingTool",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/",
        "to": "backend/"
      }
    ]
  }
}
